CORS_ORIGINS=http://localhost:5173
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
DATA_API_URL=https://data-api.polymarket.com

# PostgreSQL — use localhost for local dev, docker service name overrides this in docker-compose
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cute_trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cute_trading
POSTGRES_SCHEMA=cute_trading

# Redis — use localhost for local dev, docker service name overrides in docker-compose
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Polymarket API key (get from polymarket.com account settings)
POLYMARKET_API_KEY=

# How often to re-fetch trader data (hours)
SCHEDULER_INTERVAL_HOURS=6

# How many top traders to track from the leaderboard
LEADERBOARD_LIMIT=100
